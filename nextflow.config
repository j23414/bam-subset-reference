params {
  help = false

  // Output directory
  outdir = './subset-results'

  // Either input reads as a samplesheet (csv) with headings "sample","bam" or a glob pattern
  samplesheet = false
  bam = false

  error_strategy='ignore' // 'ignore' or 'terminate'
}

profiles {
  local { }
  stjude {
    includeConfig 'configs/stjude.config'
  }
  slurm {
    includeConfig 'configs/slurm.config'
  }
  ceres {
    includeConfig 'configs/ceres.config'
  }
  docker {
    docker.enabled = true
    singularity.enabled = false
    apptainer.enabled = false
    podman.enabled = false
    shifter.enabled = false
    charliecloud.enabled = false
  }
  singularity {
    singularity.enabled = true
    docker.enabled = false
    singularity.autoMounts = true
  }
  conda {
    conda.enabled = true
  }
}

docker.runOptions = '-u \$(id -u):\$(id -g)'

process {
  publishDir = [ path: "${params.outdir}", mode: 'copy']
  errorStrategy = params.error_strategy;
  withName: 'SAMTOOLS_SUBSET' {
    publishDir = [ path: "${params.outdir}/subset_bam", mode: 'copy']
  }
}

trace {
    enabled = true
    overwrite = true
    file = "$params.outdir/trace.txt"
}

manifest {
    name = 'j23414/bam-subset-reference'
    description = "A modular workflow for subsetting a bam alignment data to only include reads against the reference."
    version = "0.0"
    mainScript = 'main.nf'
}